# ─────────────────────────────────────────────
# SETAYESH SALON — Environment Variables
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────

# Site URL (set to your Vercel domain or custom domain in production)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact details (optional — used if you wire up a booking API)
NEXT_PUBLIC_PHONE=+16041234567
NEXT_PUBLIC_EMAIL=hello@setayeshsalon.com
NEXT_PUBLIC_INSTAGRAM=setayeshsalon

# Booking API (optional — add when integrating a real booking backend)
# BOOKING_API_URL=
# BOOKING_API_KEY=
